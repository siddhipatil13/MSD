# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/cse_department

# Port the Express server listens on
PORT=5000

# Secret used to sign JWT tokens (use any long random string)
JWT_SECRET=change_this_super_secret_key_for_demo_only

# Development-only admin login (change these before any real use)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
